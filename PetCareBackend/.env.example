NODE_ENV=development
PORT=3000

# MongoDB Connection (Local or Docker or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/petcare

# JWT Authentication
JWT_ACCESS_SECRET=petcare_jwt_super_secret_access_key_2026
JWT_REFRESH_SECRET=petcare_jwt_super_secret_refresh_key_2026
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:5173

# AI Provider (mock | openai | gemini)
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=

# Location Provider (mock | google_places | mapbox)
LOCATION_PROVIDER=mock
GOOGLE_MAPS_API_KEY=

# Storage Provider (local | s3 | cloudinary)
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
